{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "lib": ["ESNext"],
    "types": ["bun-types"],
    "paths": {
      "@tui/*": ["${configDir}/src/tui/*"],
      "@db": ["${configDir}/src/db/client.ts"],
      "@db/*": ["${configDir}/src/db/*"],
      "@monitor/*": ["${configDir}/src/monitor/*"],
      "@integrations/*": ["${configDir}/src/integrations/*"],
      "@domain/*": ["${configDir}/src/domain/*"],
      "@lib/*": ["${configDir}/src/lib/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
